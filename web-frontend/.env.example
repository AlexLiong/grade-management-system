# Optional. Keep empty in normal development so the browser uses same-origin /api.
VITE_API_BASE_URL=/api
# Spring Boot development endpoint. scripts/start-local.sh overrides this with HTTPS.
VITE_API_TARGET=https://localhost:8443
# Set these only when starting Vite manually with local TLS.
VITE_DEV_HTTPS=false
VITE_TLS_KEY=../runtime/dev-tls.key
VITE_TLS_CERT=../runtime/dev-tls.crt
